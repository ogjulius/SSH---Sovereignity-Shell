#!/bin/sh
# ssh-session — start a Sovereignity Shell desktop session.
#
#   ssh-session hyprland|niri [-- COMPOSITOR-ARGS...]
#   ssh-session --check hyprland|niri     validate everything, start nothing
#
# Used by the "Sovereignity Shell (Hyprland)" and "Sovereignity Shell (Niri)"
# login sessions. It starts the compositor exactly as its own session would,
# with the user's own configuration, and starts SSH once the compositor is up.
# It never edits the user's compositor configuration:
#
#   Hyprland  start-hyprland runs unchanged; the new instance is found by
#             process id through `hyprctl instances`, and SSH is started with
#             that instance's environment. SSH adds its keybinds at runtime,
#             skipping any key the user's config already binds.
#   Niri      niri runs with NIRI_CONFIG pointing at a generated overlay that
#             includes SSH's binds first and the user's config second (so the
#             user's binds win), plus `spawn-at-startup` for SSH. Needs niri
#             25.11 or newer (config includes).
#
# If SSH cannot start, the compositor keeps running with the user's own
# configuration, and the plain Hyprland/Niri sessions are never modified.
# Logs: ${XDG_STATE_HOME:-~/.local/state}/ssh-shell/session.log
set -u

state=${XDG_STATE_HOME:-$HOME/.local/state}/ssh-shell
log=$state/session.log
check=0

usage() { sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

[ "${1:-}" = "--check" ] && { check=1; shift; }
comp=${1:-}
[ $# -gt 0 ] && shift
[ "${1:-}" = "--" ] && shift
case $comp in hyprland|niri) ;; *) usage ;; esac

mkdir -p "$state/session" 2>/dev/null || true
if [ $check -eq 0 ]; then
    [ -f "$log" ] && mv -f "$log" "$log.old" 2>/dev/null
    : > "$log" 2>/dev/null || log=/dev/null
fi
say() {
    printf '%s\n' "ssh-session: $*" >&2
    [ $check -eq 1 ] || printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$log"
}
problems=0
need() { # need <command> <why>
    if command -v "$1" >/dev/null 2>&1; then [ $check -eq 1 ] && say "ok      $1 ($(command -v "$1"))"; return 0; fi
    say "missing $1 — $2"; problems=$((problems+1)); return 1
}

need ssh-shell "SSH is not installed (or not on PATH)"
need qs "Quickshell is not installed; SSH cannot start"

# ── Niri ────────────────────────────────────────────────────────────────
niri_version() { niri --version 2>/dev/null | sed -n 's/^niri \([0-9][0-9]*\)\.\([0-9][0-9]*\).*/\1 \2/p'; }
kdl_str() { printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"; }

niri_overlay() { # writes the overlay; prints its path
    user_cfg=${NIRI_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/niri/config.kdl}
    # A user who never started niri has no config yet; niri would write its
    # default one on first start, so do the same rather than leave the
    # session without any of niri's own binds.
    if [ ! -e "$user_cfg" ]; then
        for d in /usr/share/doc/niri/default-config.kdl /usr/share/niri/default-config.kdl \
                 /run/current-system/sw/share/doc/niri/default-config.kdl; do
            if [ -f "$d" ]; then
                mkdir -p "$(dirname "$user_cfg")" && cp "$d" "$user_cfg" && say "created $user_cfg from niri's default config"
                break
            fi
        done
    fi
    binds=$state/session/niri-binds.kdl
    [ -f "$binds" ] || printf '// Written by SSH at runtime from its "shortcuts" options.\n' > "$binds"
    overlay=$state/session/niri.kdl
    {
        echo "// Generated by ssh-session at every login. Do not edit: edit your own"
        echo "// niri config instead; it is included below and its settings win."
        echo "include optional=true $(kdl_str "$binds")"
        echo "include optional=true $(kdl_str "$user_cfg")"
        echo "spawn-at-startup \"ssh-shell\" \"session-run\""
    } > "$overlay"
    printf '%s' "$overlay"
}

if [ "$comp" = niri ]; then
    need niri "Niri is not installed" || { [ $check -eq 1 ] && exit 1; }
    v=$(niri_version); maj=${v% *}; min=${v#* }
    if [ -z "$v" ] || [ "$maj" -lt 25 ] || { [ "$maj" -eq 25 ] && [ "$min" -lt 11 ]; }; then
        say "niri ${v:-unknown} is too old for the SSH session (needs 25.11+ for config includes)"
        problems=$((problems+1))
        if [ $check -eq 0 ]; then say "starting plain niri instead; SSH will not start"; exec niri-session "$@" 2>/dev/null || exec niri "$@"; fi
    fi
    overlay=$(niri_overlay)
    if [ $check -eq 1 ]; then
        if niri validate -c "$overlay" >/dev/null 2>&1; then say "ok      niri accepts the session overlay ($overlay)"
        else say "niri rejects the session overlay:"; niri validate -c "$overlay" >&2; problems=$((problems+1)); fi
        [ $problems -eq 0 ] && say "session ready" || say "$problems problem(s)"
        exit $((problems > 0))
    fi
    export NIRI_CONFIG="$overlay" SSH_SESSION=niri XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP:-niri}
    say "starting niri with overlay $overlay"
    if command -v niri-session >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
        # niri-session imports our environment into the systemd user manager;
        # remove SSH's variables afterwards so a later plain Niri login is clean.
        cleanup() { systemctl --user unset-environment NIRI_CONFIG SSH_SESSION 2>/dev/null; }
        trap cleanup EXIT
        trap 'cleanup; exit 143' TERM
        trap 'cleanup; exit 129' HUP
        trap 'cleanup; exit 130' INT
        niri-session "$@"
        rc=$?
        say "niri-session exited ($rc)"
        exit $rc
    fi
    exec niri "$@"
fi

# ── Hyprland ────────────────────────────────────────────────────────────
need hyprctl "hyprctl is part of Hyprland; cannot find the new instance" || true
if command -v start-hyprland >/dev/null 2>&1; then launcher=start-hyprland
else need Hyprland "Hyprland is not installed" || { [ $check -eq 1 ] && exit 1; }; launcher=Hyprland; fi
if [ $check -eq 1 ]; then
    say "ok      launcher: $launcher"
    [ $problems -eq 0 ] && say "session ready" || say "$problems problem(s)"
    exit $((problems > 0))
fi

export SSH_SESSION=hyprland XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP:-Hyprland}
# Background one simple command so that $! is the launcher itself.
if [ "$launcher" = Hyprland ]; then set -- Hyprland "$@"
elif [ $# -gt 0 ]; then set -- start-hyprland -- "$@"
else set -- start-hyprland
fi
"$@" &
cpid=$!
say "started $launcher (pid $cpid)"
trap 'kill -TERM "$cpid" 2>/dev/null' TERM INT HUP

# The instance started by us: its pid is $cpid or a descendant of it
# (start-hyprland is a watchdog that runs Hyprland as its child, and the
# shell may fork in between). Prints "<signature> <socket>".
find_instance() {
    hyprctl instances -j 2>/dev/null | awk -v want="$cpid" '
        function parent(p,   f, line, a) {
            f = "/proc/" p "/stat"
            if ((getline line < f) <= 0) return -1
            close(f); sub(/.*\) /, "", line); split(line, a, " "); return a[2]
        }
        function descends(p,   n) {
            for (n = 0; n < 6 && p > 1; n++) { if (p == want) return 1; p = parent(p) }
            return 0
        }
        /"instance"/ { gsub(/[",]/, ""); sig = $2 }
        /"pid"/      { gsub(/[",]/, ""); pid = $2 }
        /"wl_socket"/ {
            gsub(/[",]/, ""); sock = $2
            if (descends(pid)) { print sig, sock; exit }
        }'
}

inst=""
i=0
while [ $i -lt 300 ] && kill -0 "$cpid" 2>/dev/null; do
    inst=$(find_instance)
    [ -n "$inst" ] && break
    sleep 0.1; i=$((i+1))
done

spid=""
if [ -n "$inst" ]; then
    export HYPRLAND_INSTANCE_SIGNATURE=${inst% *} WAYLAND_DISPLAY=${inst#* }
    say "Hyprland is up: instance $HYPRLAND_INSTANCE_SIGNATURE on $WAYLAND_DISPLAY"
    ssh-shell session-run &
    spid=$!
else
    say "could not find the new Hyprland instance after 30 s; SSH not started (the compositor keeps running)"
fi

# `wait` returns early when a trapped signal arrives; keep waiting until the
# compositor has really gone.
wait "$cpid"; rc=$?
while kill -0 "$cpid" 2>/dev/null; do wait "$cpid"; rc=$?; done
say "$launcher exited ($rc)"
[ -n "$spid" ] && kill "$spid" 2>/dev/null
exit "$rc"
